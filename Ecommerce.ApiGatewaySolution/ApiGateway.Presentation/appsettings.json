{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Ecommerce.Auth",
    "Audience": "Ecommerce.Api",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:5173"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowMinutes": 1
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous"
      },
      "products-read-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/v1/products/{**catch-all}",
          "Methods": [
            "GET"
          ]
        },
        "AuthorizationPolicy": "anonymous"
      },
      "products-write-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/v1/products/{**catch-all}",
          "Methods": [
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "AuthorizationPolicy": "CatalogWrite"
      },
      "orders-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/v1/orders/{**catch-all}"
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "inventory-read-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/v1/inventory/{**catch-all}",
          "Methods": [
            "GET"
          ]
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "inventory-write-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/v1/inventory/{**catch-all}",
          "Methods": [
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "AuthorizationPolicy": "InventoryWrite"
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-api": {
            "Address": "https://localhost:7183/"
          }
        }
      },
      "product-cluster": {
        "Destinations": {
          "product-api": {
            "Address": "https://localhost:7060/"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order-api": {
            "Address": "https://localhost:7035/"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "inventory-api": {
            "Address": "https://localhost:7003/"
          }
        }
      }
    }
  }
}